# Copia este archivo como .env y completa los valores.

# Clave para firmar las sesiones. Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Credenciales OAuth de Google (Google Cloud Console > APIs y servicios > Credenciales).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dominios de correo que pueden ingresar, separados por coma.
DOMINIOS_PERMITIDOS=mail.pucv.cl

# Carpeta pública de Drive donde la federación publica las planillas.
DRIVE_CARPETA_ID=1g2ZvhjbvHZ9SJYYw8cqsdCQn5ZY3WESf
# Opcional: clave de API de Google para listar la carpeta con la API oficial (más estable).
GOOGLE_API_KEY=

# Revisión automática (formato crontab, hora de Chile). Por defecto: domingos 23:00.
ACTUALIZACION_CRON=0 23 * * sun
ZONA_HORARIA=America/Santiago

# Dónde se guardan las planillas descargadas.
DATA_DIR=./data

# En producción (HTTPS) déjalo en 1. Para probar en http://localhost usa 0.
COOKIE_SEGURA=1
